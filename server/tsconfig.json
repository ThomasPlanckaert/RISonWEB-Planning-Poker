{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@planning-poker/shared": ["../shared/types/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../shared" }]
}
