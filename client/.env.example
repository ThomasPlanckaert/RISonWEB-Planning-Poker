# Firebase (Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base path for GitHub Pages (e.g. /RISonWEB-Planning-Poker/)
VITE_BASE_PATH=/

# Cloud Functions region (must match deployed functions)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Set to "true" to use local Firebase emulators
VITE_USE_FIREBASE_EMULATORS=false
